/* Modern Static Analysis Viewer CSS */
/* Clean, responsive design for standalone browser use */

:root {
  --primary-color: #0066cc;
  --background-light: #ffffff;
  --background-section: #f8f9fa;
  --text-primary: #212529;
  --text-secondary: #6c757d;
  --border-color: #dee2e6;
  --success-color: #28a745;
  --warning-color: #ffc107;
  --danger-color: #dc3545;
  --info-color: #17a2b8;
  
  /* Complexity colors */
  --complexity-simple: #28a745;
  --complexity-moderate: #ffc107;
  --complexity-complex: #fd7e14;
  --complexity-critical: #dc3545;
  
  /* Shadows and spacing */
  --shadow-sm: 0 1px 3px rgba(0,0,0,0.12), 0 1px 2px rgba(0,0,0,0.24);
  --shadow-md: 0 3px 6px rgba(0,0,0,0.16), 0 3px 6px rgba(0,0,0,0.23);
  --border-radius: 8px;
  --spacing-xs: 4px;
  --spacing-sm: 8px;
  --spacing-md: 16px;
  --spacing-lg: 24px;
  --spacing-xl: 32px;
}

* {
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 14px;
  line-height: 1.6;
  color: var(--text-primary);
  background-color: var(--background-light);
  margin: 0;
  padding: var(--spacing-lg);
}

#app {
  max-width: 1200px;
  margin: 0 auto;
}

.hidden {
  display: none !important;
}

/* Header Section */
.header {
  text-align: center;
  margin-bottom: var(--spacing-xl);
  padding-bottom: var(--spacing-lg);
  border-bottom: 2px solid var(--border-color);
}

.header h1 {
  color: var(--primary-color);
  font-size: 2.5rem;
  font-weight: 700;
  margin: 0 0 var(--spacing-sm) 0;
}

.header .subtitle {
  color: var(--text-secondary);
  font-size: 1.1rem;
  margin: 0;
  font-weight: 400;
}

/* Message Section */
.message {
  text-align: center;
  padding: var(--spacing-xl);
  background-color: var(--background-section);
  border-radius: var(--border-radius);
  border: 1px solid var(--border-color);
}

.message p {
  color: var(--text-secondary);
  font-size: 1.1rem;
  margin: 0;
}

/* Section Styling */
.section {
  background-color: var(--background-section);
  border-radius: var(--border-radius);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  border: 1px solid var(--border-color);
  box-shadow: var(--shadow-sm);
}

.section h2 {
  color: var(--primary-color);
  font-size: 1.5rem;
  font-weight: 600;
  margin: 0 0 var(--spacing-lg) 0;
  padding-bottom: var(--spacing-sm);
  border-bottom: 2px solid var(--primary-color);
}

.section h3 {
  color: var(--text-primary);
  font-size: 1.2rem;
  font-weight: 600;
  margin: 0 0 var(--spacing-md) 0;
}

/* Metrics Grid */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: var(--spacing-md);
}

.metric {
  background-color: var(--background-light);
  border-radius: var(--border-radius);
  padding: var(--spacing-md);
  text-align: center;
  border: 1px solid var(--border-color);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.metric:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
}

.metric-value {
  font-size: 2rem;
  font-weight: 700;
  color: var(--primary-color);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.metric-label {
  font-size: 0.9rem;
  color: var(--text-secondary);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.ccn-metric .metric-value {
  color: var(--warning-color);
}

.high-complexity-metric .metric-value {
  color: var(--danger-color);
}

/* Complexity Summary */
.complexity-summary {
  margin-bottom: var(--spacing-lg);
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: var(--spacing-md);
}

.summary-item {
  background-color: var(--background-light);
  border-radius: var(--border-radius);
  padding: var(--spacing-md);
  border-left: 4px solid var(--info-color);
}

.summary-item.highest {
  border-left-color: var(--danger-color);
}

.summary-item.lowest {
  border-left-color: var(--success-color);
}

.summary-item.warning {
  border-left-color: var(--warning-color);
}

.summary-label {
  font-size: 0.9rem;
  color: var(--text-secondary);
  font-weight: 500;
  margin-bottom: var(--spacing-xs);
}

.summary-value {
  font-size: 1.2rem;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--spacing-xs);
}

.summary-detail {
  font-size: 0.9rem;
  color: var(--text-secondary);
}

/* Table Styling */
.table-container {
  overflow-x: auto;
  border-radius: var(--border-radius);
  border: 1px solid var(--border-color);
  background-color: var(--background-light);
}

.functions-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9rem;
}

.functions-table thead {
  background-color: var(--primary-color);
  color: white;
}

.functions-table th {
  padding: var(--spacing-md);
  text-align: left;
  font-weight: 600;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.functions-table td {
  padding: var(--spacing-sm) var(--spacing-md);
  border-bottom: 1px solid var(--border-color);
}

.functions-table tbody tr:hover {
  background-color: var(--background-section);
}

.functions-table tbody tr:last-child td {
  border-bottom: none;
}

.function-name {
  font-weight: 600;
  color: var(--primary-color);
}

.function-name.clickable {
  cursor: pointer;
  text-decoration: underline;
}

.function-name.clickable:hover {
  color: var(--danger-color);
}

/* Complexity indicators */
.complexity {
  font-weight: 600;
  padding: var(--spacing-xs) var(--spacing-sm);
  border-radius: 4px;
  text-align: center;
}

.complexity.simple {
  background-color: var(--complexity-simple);
  color: white;
}

.complexity.moderate {
  background-color: var(--complexity-moderate);
  color: white;
}

.complexity.complex {
  background-color: var(--complexity-complex);
  color: white;
}

.complexity.critical {
  background-color: var(--complexity-critical);
  color: white;
}

.density {
  font-weight: 500;
  text-align: center;
}

.density.low {
  color: var(--complexity-simple);
}

.density.medium {
  color: var(--complexity-moderate);
}

.density.high {
  color: var(--complexity-complex);
}

.density.very-high {
  color: var(--complexity-critical);
}

/* Distribution Section */
.distribution-container {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: var(--spacing-xl);
  align-items: center;
}

.distribution-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: var(--spacing-md);
}

.distribution-item {
  background-color: var(--background-light);
  border-radius: var(--border-radius);
  padding: var(--spacing-md);
  text-align: center;
  border: 1px solid var(--border-color);
}

.distribution-item.simple {
  border-left: 4px solid var(--complexity-simple);
}

.distribution-item.moderate {
  border-left: 4px solid var(--complexity-moderate);
}

.distribution-item.complex {
  border-left: 4px solid var(--complexity-complex);
}

.distribution-item.very-complex {
  border-left: 4px solid var(--complexity-critical);
}

.distribution-value {
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--primary-color);
  margin-bottom: var(--spacing-xs);
}

.distribution-label {
  font-size: 0.85rem;
  color: var(--text-secondary);
  font-weight: 500;
}

/* Chart Container */
.chart-container {
  max-width: 300px;
  width: 100%;
}

.chart-container canvas {
  max-width: 100%;
  height: auto;
}

/* Density Section */
.density-container {
  max-width: 500px;
  margin: 0 auto;
}

.density-bar-container {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  background-color: var(--background-light);
  padding: var(--spacing-md);
  border-radius: var(--border-radius);
  border: 1px solid var(--border-color);
}

.density-label {
  font-weight: 600;
  color: var(--text-primary);
  min-width: 120px;
}

.density-bar {
  flex: 1;
  height: 20px;
  background-color: var(--border-color);
  border-radius: 10px;
  overflow: hidden;
  position: relative;
}

.density-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--complexity-simple), var(--complexity-moderate), var(--complexity-complex));
  transition: width 0.5s ease;
  border-radius: 10px;
}

.density-value {
  font-weight: 600;
  color: var(--primary-color);
  min-width: 60px;
  text-align: right;
}

/* Loading and No Data States */
.loading-message,
.no-data {
  text-align: center;
  color: var(--text-secondary);
  font-style: italic;
  padding: var(--spacing-lg);
}

/* Responsive Design */
@media (max-width: 768px) {
  body {
    padding: var(--spacing-md);
  }
  
  .header h1 {
    font-size: 2rem;
  }
  
  .metrics-grid {
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }
  
  .distribution-container {
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
  }
  
  .summary-grid {
    grid-template-columns: 1fr;
  }
  
  .functions-table {
    font-size: 0.8rem;
  }
  
  .functions-table th,
  .functions-table td {
    padding: var(--spacing-xs) var(--spacing-sm);
  }
}

@media (max-width: 480px) {
  .header h1 {
    font-size: 1.6rem;
  }
  
  .metric-value {
    font-size: 1.5rem;
  }
  
  .section {
    padding: var(--spacing-md);
  }
}

/* Print Styles */
@media print {
  body {
    background-color: white;
    color: black;
    padding: 0;
  }
  
  .section {
    box-shadow: none;
    border: 1px solid #ccc;
    break-inside: avoid;
  }
  
  .chart-container {
    break-inside: avoid;
  }
}
