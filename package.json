{
  "name": "code-xr",
  "displayName": "Code-XR",
  "description": "XR-powered extension for code metric visualization using BabiaXR and A-Frame",
  "version": "0.0.8",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/aMonteSl/CodeXR.git"
  },
  "license": "MIT",
  "publisher": "aMonteSl",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "CodeXR.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "codexr.server.launch",
        "title": "Start Local Server"
      },
      {
        "command": "codexr.server.configure",
        "title": "Server Configuration"
      },
      {
        "command": "codexr.server.config.httpMode",
        "title": "Configure HTTP Mode"
      },
      {
        "command": "codexr.server.config.port",
        "title": "Configure Default Port"
      },
      {
        "command": "codexr.server.config.autoOpen",
        "title": "Toggle Auto-Open"
      },
      {
        "command": "codexr.server.config.openMode",
        "title": "Configure Open Mode"
      },
      {
        "command": "codeXR.activeServers.showActions",
        "title": "Show Server Actions",
        "icon": "$(menu)"
      },
      {
        "command": "codeXR.activeServers.openInBrowser",
        "title": "Open in Browser",
        "icon": "$(browser)"
      },
      {
        "command": "codeXR.activeServers.openInPanel",
        "title": "Open in Panel",
        "icon": "$(layout-panel)"
      },
      {
        "command": "codeXR.activeServers.copyUrl",
        "title": "Copy URL",
        "icon": "$(copy)"
      },
      {
        "command": "codeXR.activeServers.stopServer",
        "title": "Stop Server",
        "icon": "$(stop-circle)"
      },
      {
        "command": "codeXR.activeServers.showDetails",
        "title": "Show Details",
        "icon": "$(info)"
      },
      {
        "command": "codeXR.activeServers.stopAllServers",
        "title": "Stop All Servers",
        "icon": "$(stop)"
      },
      {
        "command": "codeXR.activeServers.refreshServers",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "codeXR.activeServers.openView",
        "title": "Open Active Servers"
      },
      {
        "command": "codeXR.babiaExamples.launchExample",
        "title": "Launch Example",
        "icon": "$(play)"
      },
      {
        "command": "codeXR.babiaExamples.refresh",
        "title": "Refresh Examples",
        "icon": "$(refresh)"
      },
      {
        "command": "codeXR.babiaExamples.openFolder",
        "title": "Open Examples Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "codeXR.babiaExamples.showDetails",
        "title": "Show Example Details",
        "icon": "$(info)"
      },
      {
        "command": "codeXR.babiaExamples.openView",
        "title": "Open Babia Examples"
      },
      {
        "command": "codeXR.visualizeData.chartType",
        "title": "Select Chart Type",
        "icon": "$(graph)"
      },
      {
        "command": "codeXR.visualizeData.selectJson",
        "title": "Select JSON File",
        "icon": "$(file-code)"
      },
      {
        "command": "codeXR.visualizeData.dimensionMapping",
        "title": "Configure Dimension Mapping",
        "icon": "$(settings-gear)"
      },
      {
        "command": "codeXR.visualizeData.launchVisualization",
        "title": "Launch Visualization",
        "icon": "$(play)"
      },
      {
        "command": "codeXR.pythonEnv.create",
        "title": "Create Python Environment",
        "icon": "$(add)"
      },
      {
        "command": "codeXR.pythonEnv.delete",
        "title": "Delete Python Environment",
        "icon": "$(trash)"
      },
      {
        "command": "codeXR.pythonEnv.status",
        "title": "Python Environment Status",
        "icon": "$(info)"
      },
      {
        "command": "codeXR.pythonEnv.installPackage",
        "title": "Install Python Package",
        "icon": "$(cloud-download)"
      },
      {
        "command": "codeXR.pythonEnv.reinitialize",
        "title": "Reinitialize Python Environment",
        "icon": "$(refresh)"
      },
      {
        "command": "newCodeAnalysis.analyzeFile",
        "title": "CodeXR: Analyze File (LivePanel)",
        "icon": "$(file-code)"
      },
      {
        "command": "newCodeAnalysis.analyzeFileXR",
        "title": "CodeXR: Analyze File (XR)",
        "icon": "$(device-camera-video)"
      },
      {
        "command": "newCodeAnalysis.visualizeDOM",
        "title": "CodeXR: Visualize DOM",
        "icon": "$(browser)"
      },
      {
        "command": "newCodeAnalysis.activeAnalyses.closeAnalysis",
        "title": "Close Analysis",
        "icon": "$(close)"
      },
      {
        "command": "newCodeAnalysis.activeAnalyses.openInBrowser",
        "title": "Open in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "newCodeAnalysis.activeAnalyses.viewDetails",
        "title": "View Details",
        "icon": "$(info)"
      },
      {
        "command": "newCodeAnalysis.activeAnalyses.refreshAll",
        "title": "Refresh Active Analyses",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexr",
          "title": "CODEXR",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "codexr": [
        {
          "id": "codexrTree",
          "name": "CODEXR",
          "when": "true",
          "icon": "$(server-environment)"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codeXR.activeServers.refreshServers",
          "when": "view == codexrTree",
          "group": "navigation@1"
        },
        {
          "command": "codeXR.activeServers.stopAllServers",
          "when": "view == codexrTree",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "newCodeAnalysis.analyzeFile",
          "when": "resourceExtname =~ /\\.(py|pyw|pyi|rb|rbw|java|c|h|cpp|cxx|cc|hpp|hxx|cs|erl|hrl|f|f90|f95|f03|f08|gd|go|js|mjs|cjs|kt|kts|lua|m|mm|php|phtml|php3|php4|php5|pl|pm|scala|sc|sol|swift|ts|tsx|ttcn|ttcn3|vue|zig)$/",
          "group": "codexr@1"
        },
        {
          "command": "newCodeAnalysis.analyzeFileXR",
          "when": "resourceExtname =~ /\\.(py|pyw|pyi|rb|rbw|java|c|h|cpp|cxx|cc|hpp|hxx|cs|erl|hrl|f|f90|f95|f03|f08|gd|go|js|mjs|cjs|kt|kts|lua|m|mm|php|phtml|php3|php4|php5|pl|pm|scala|sc|sol|swift|ts|tsx|ttcn|ttcn3|vue|zig)$/",
          "group": "codexr@2"
        },
        {
          "command": "newCodeAnalysis.visualizeDOM",
          "when": "resourceExtname =~ /\\.(html|htm|xhtml)$/",
          "group": "codexr@1"
        }
      ],
      "editor/context": [
        {
          "command": "newCodeAnalysis.analyzeFile",
          "when": "resourceExtname =~ /\\.(py|pyw|pyi|rb|rbw|java|c|h|cpp|cxx|cc|hpp|hxx|cs|erl|hrl|f|f90|f95|f03|f08|gd|go|js|mjs|cjs|kt|kts|lua|m|mm|php|phtml|php3|php4|php5|pl|pm|scala|sc|sol|swift|ts|tsx|ttcn|ttcn3|vue|zig)$/",
          "group": "codexr@1"
        },
        {
          "command": "newCodeAnalysis.analyzeFileXR",
          "when": "resourceExtname =~ /\\.(py|pyw|pyi|rb|rbw|java|c|h|cpp|cxx|cc|hpp|hxx|cs|erl|hrl|f|f90|f95|f03|f08|gd|go|js|mjs|cjs|kt|kts|lua|m|mm|php|phtml|php3|php4|php5|pl|pm|scala|sc|sol|swift|ts|tsx|ttcn|ttcn3|vue|zig)$/",
          "group": "codexr@2"
        },
        {
          "command": "newCodeAnalysis.visualizeDOM",
          "when": "resourceExtname =~ /\\.(html|htm|xhtml)$/",
          "group": "codexr@1"
        }
      ],
      "view/item/context": [
        {
          "command": "newCodeAnalysis.activeAnalyses.closeAnalysis",
          "when": "view == codexrTree && viewItem =~ /^activeAnalysis\\.(creating|analyzing|completed|failed)$/",
          "group": "activeAnalyses@1"
        },
        {
          "command": "newCodeAnalysis.activeAnalyses.openInBrowser",
          "when": "view == codexrTree && viewItem =~ /^activeAnalysis\\.(completed)$/",
          "group": "activeAnalyses@2"
        },
        {
          "command": "newCodeAnalysis.activeAnalyses.viewDetails",
          "when": "view == codexrTree && viewItem =~ /^activeAnalysis\\.(creating|analyzing|completed|failed)$/",
          "group": "activeAnalyses@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.98.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.100.2",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "get-port": "^7.1.0"
  }
}
