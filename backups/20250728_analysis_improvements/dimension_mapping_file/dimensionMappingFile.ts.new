/**
 * Dimension Mapping File Setting Item
 * Manages the dimension mapping configuration for file analysis
 */

import * as vscode from 'vscode';
import { NewCodeAnalysisTreeItem } from '../../../items/newCodeAnalysisItems';
import { AnalysisConfigurationStorage } from '../../../../configuration';

export type MappingType = 'TODO1' | 'TODO2' | 'TODO3';
export type AnalysisMode = 'XR' | 'LivePanel';

export interface DimensionMappingInfo {
    id: string;
    name: string;
    description: string;
}

export class DimensionMappingFileSetting {
    private storage: AnalysisConfigurationStorage;

    constructor(context: vscode.ExtensionContext) {
        this.storage = AnalysisConfigurationStorage.getInstance(context);
    }

    /**
     * Get the tree item for this setting
     */
    async getSettingItem(): Promise<NewCodeAnalysisTreeItem> {
        // Get current values from storage
        const currentMode = await this.storage.getAnalysisMode();
        const currentMapping = await this.storage.getDimensionMappingFile();
        
        const label = `Dimension Mapping (File): ${currentMapping}`;
        const description = `${currentMapping} for ${currentMode} mode`;
        
        // Dynamic icon color based on analysis mode
        let iconColor = 'charts.foreground';
        if (currentMode === 'XR') {
            iconColor = 'charts.purple'; // Purple for XR mode
        } else if (currentMode === 'LivePanel') {
            iconColor = 'charts.green'; // Green for LivePanel mode
        }
        
        const iconPath = new vscode.ThemeIcon('symbol-misc', new vscode.ThemeColor(iconColor));
        
        return new NewCodeAnalysisTreeItem(
            label,
            vscode.TreeItemCollapsibleState.Collapsed, // Collapsed to show children (TODO1, TODO2, TODO3)
            'subsection',
            {
                command: 'newCodeAnalysis.selectDimensionMappingFile',
                title: 'Select Dimension Mapping for File Analysis',
                arguments: []
            },
            iconPath,
            `Current dimension mapping: ${currentMapping} for ${currentMode} mode`,
            description,
            'dimensionMappingFileSetting'
        );
    }

    /**
     * Get children items (TODO1, TODO2, TODO3)
     */
    async getChildren(): Promise<NewCodeAnalysisTreeItem[]> {
        const currentMode = await this.storage.getAnalysisMode();
        const currentMapping = await this.storage.getDimensionMappingFile();
        
        // Dynamic icon color based on analysis mode
        let iconColor = 'charts.foreground';
        if (currentMode === 'XR') {
            iconColor = 'charts.purple'; // Purple for XR mode
        } else if (currentMode === 'LivePanel') {
            iconColor = 'charts.green'; // Green for LivePanel mode
        }
        
        const children: NewCodeAnalysisTreeItem[] = [];
        
        const mappingOptions: MappingType[] = ['TODO1', 'TODO2', 'TODO3'];
        
        for (const option of mappingOptions) {
            const isSelected = option === currentMapping;
            const iconName = isSelected ? 'symbol-method' : 'symbol-method';
            const iconPath = new vscode.ThemeIcon(iconName, new vscode.ThemeColor(iconColor));
            
            const child = new NewCodeAnalysisTreeItem(
                option,
                vscode.TreeItemCollapsibleState.None,
                'subsection',
                {
                    command: 'newCodeAnalysis.setDimensionMappingFile',
                    title: `Set Dimension Mapping to ${option}`,
                    arguments: [option]
                },
                iconPath,
                `Set dimension mapping to ${option} for ${currentMode} mode`,
                isSelected ? 'Currently selected' : undefined,
                `dimensionMapping_${option}`
            );
            
            children.push(child);
        }
        
        return children;
    }

    /**
     * TODO: Get current analysis mode
     */
    async getCurrentAnalysisMode(): Promise<AnalysisMode> {
        return this.storage.getAnalysisMode();
    }

    /**
     * TODO: Get available mapping types based on analysis mode
     */
    async getAvailableMappingTypes(mode: AnalysisMode): Promise<DimensionMappingInfo[]> {
        // TODO: Return different mapping types based on XR vs LivePanel mode
        return [
            { id: 'TODO1', name: 'First mapping', description: 'First dimension mapping type' },
            { id: 'TODO2', name: 'Second mapping', description: 'Second dimension mapping type' },
            { id: 'TODO3', name: 'Third mapping', description: 'Third dimension mapping type' }
        ];
    }

    /**
     * TODO: Set dimension mapping
     */
    async setDimensionMapping(mappingType: string): Promise<void> {
        // TODO: Validate mapping type
        const validMappingType = mappingType as MappingType;
        await this.storage.setDimensionMappingFile(validMappingType);
    }

    /**
     * TODO: Get current dimension mapping
     */
    async getCurrentDimensionMapping(): Promise<MappingType> {
        return this.storage.getDimensionMappingFile();
    }

    /**
     * TODO: Save configuration
     */
    async saveConfiguration(mappingType: MappingType, configuration: any): Promise<void> {
        // TODO: Save to configuration storage
        console.log(`DIMENSION_MAPPING_FILE_SETTING: Saving mapping ${mappingType}:`, configuration);
    }
}
