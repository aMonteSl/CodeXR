/**
 * Chart Type File Setting Item
 * Manages the chart type configuration for file analysis
 */

import * as vscode from 'vscode';
import { NewCodeAnalysisTreeItem } from '../../../items/newCodeAnalysisItems';
import { AnalysisConfigurationStorage } from '../../../../configuration';

export type AnalysisMode = 'XR' | 'LivePanel';
export type ChartType = 'TODO1' | 'TODO2' | 'TODO3' | 'TODO4';

export interface ChartTypeInfo {
    name: string;
    description: string;
    supportsMode: string;
}

export class ChartTypeFileSetting {
    private currentChartType: ChartType = 'TODO1';
    private storage: AnalysisConfigurationStorage;

    constructor(context: vscode.ExtensionContext) {
        this.storage = AnalysisConfigurationStorage.getInstance(context);
    }

    /**
     * Get the tree item for this setting
     */
    async getSettingItem(): Promise<NewCodeAnalysisTreeItem> {
        // Get current values from storage
        const currentMode = await this.storage.getAnalysisMode();
        const currentChartType = await this.storage.getChartTypeFile();
        
        const label = `Chart Type (File): ${currentChartType}`;
        const description = `${currentChartType} for ${currentMode} mode`;
        
        // Dynamic icon color based on analysis mode
        let iconColor = 'charts.foreground';
        if (currentMode === 'XR') {
            iconColor = 'charts.purple'; // Purple for XR mode
        } else if (currentMode === 'LivePanel') {
            iconColor = 'charts.green'; // Green for LivePanel mode
        }
        
        const iconPath = new vscode.ThemeIcon('graph', new vscode.ThemeColor(iconColor));
        
        return new NewCodeAnalysisTreeItem(
            label,
            vscode.TreeItemCollapsibleState.None,
            'subsection',
            {
                command: 'newCodeAnalysis.selectChartTypeFile',
                title: 'Select Chart Type for File Analysis',
                arguments: []
            },
            iconPath,
            `Current chart type: ${currentChartType} for ${currentMode} mode`,
            description,
            'chartTypeFileSetting'
        );
    }

    /**
     * TODO: Get current analysis mode
     */
    async getCurrentAnalysisMode(): Promise<AnalysisMode> {
        return this.storage.getAnalysisMode();
    }

    /**
     * TODO: Get available chart types based on analysis mode
     */
    async getAvailableChartTypes(mode: AnalysisMode): Promise<ChartTypeInfo[]> {
        // TODO: Return different chart types based on XR vs LivePanel mode
        return [
            { name: 'TODO1', description: 'First chart type', supportsMode: mode },
            { name: 'TODO2', description: 'Second chart type', supportsMode: mode },
            { name: 'TODO3', description: 'Third chart type', supportsMode: mode },
            { name: 'TODO4', description: 'Fourth chart type', supportsMode: mode }
        ];
    }

    /**
     * TODO: Set chart type
     */
    async setChartType(chartType: string): Promise<void> {
        // TODO: Validate chart type
        const validChartType = chartType as ChartType;
        await this.storage.setChartTypeFile(validChartType);
        this.currentChartType = validChartType;
    }

    /**
     * TODO: Get current chart type
     */
    async getCurrentChartType(): Promise<ChartType> {
        return this.storage.getChartTypeFile();
    }

    /**
     * TODO: Save configuration
     */
    async saveConfiguration(configuration: any): Promise<void> {
        // TODO: Save to configuration storage
        console.log('CHART_TYPE_FILE_SETTING: Saving configuration:', configuration);
    }

    /**
     * TODO: Load configuration
     */
    async loadConfiguration(): Promise<any> {
        // TODO: Load from configuration storage
        const currentChartType = await this.storage.getChartTypeFile();
        const currentMode = await this.storage.getAnalysisMode();
        
        return {
            chartType: currentChartType,
            analysisMode: currentMode
        };
    }

    /**
     * Get current chart type synchronously
     */
    getCurrentChartType(): ChartType {
        return this.currentChartType;
    }
}
