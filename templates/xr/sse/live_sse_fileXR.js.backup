/**
 * XR File Analysis Live SSE Client
 * Handles real-time updates for XR file analysis visualizations
 */

console.log('🥽 Setting up EventSource for XR file analysis live updates...');

const eventSource = new EventSource('/live-reload');
let isXRMode = false;

// Check if we're in an A-Frame scene
function checkXRMode() {
  isXRMode = !!document.querySelector('a-scene');
  console.log(isXRMode ? '🥽 XR mode detected' : '🖥️ Standard mode detected');
  return isXRMode;
}

document.addEventListener('DOMContentLoaded', checkXRMode);

eventSource.onopen = function() {
  console.log('🟢 XR Analysis EventSource connection established');
};

eventSource.onerror = function(err) {
  console.error('🔴 XR Analysis EventSource error:', err);
  // Try to reconnect after a delay
  setTimeout(() => {
    console.log('🔄 Attempting to reconnect XR Analysis EventSource...');
    eventSource.close();
    new EventSource('/live-reload');
  }, 3000);
};

// Handle incoming SSE messages
eventSource.onmessage = function(event) {
  try {
    console.log('🥽 XR Analysis: Raw SSE event.data:', event.data);
    const data = JSON.parse(event.data);
    console.log('🥽 XR Analysis: Parsed SSE data:', data);
    
    handleXRSSEMessage(data);
  } catch (error) {
    console.error('🥽 XR Analysis: Error parsing SSE message:', error);
    console.error('🥽 XR Analysis: Raw event.data was:', event.data);
  }
};

/**
 * Handle incoming SSE messages for XR analysis
 */
function handleXRSSEMessage(data) {
  console.log('🥽 XR Analysis: Handling SSE message, data.type:', data.type);
  console.log('🥽 XR Analysis: Full data object:', data);
  
  // Check if we have nested data (EnhancedSSEManager format)
  const messageType = data.type || (data.data && data.data.type);
  console.log('🥽 XR Analysis: Determined message type:', messageType);
  
  switch (messageType) {
    case 'connected':
      console.log('🥽 XR Analysis: SSE connected for file:', data.fileUri || data.data?.fileUri);
      showXRStatus('connected');
      break;
      
    case 'analysis-updated':
      console.log('🥽 XR Analysis: Analysis updated for file:', data.fileUri || data.data?.fileUri);
      console.log('🥽 XR Analysis: Triggering XR data reload...');
      showXRUpdateNotification();
      reloadXRAnalysisData();
      break;
      
    case 'heartbeat':
      console.log('🥽 XR Analysis: Heartbeat received');
      // Keep-alive message, no action needed
      break;
      
    default:
      console.log('🥽 XR Analysis: Unknown SSE message type:', messageType);
      console.log('🥽 XR Analysis: Full data:', data);
  }
}

/**
 * Reload XR analysis data after SSE update notification
 */
function reloadXRAnalysisData() {
  console.log('🥽 XR Analysis: Reloading XR analysis data due to SSE update...');
  
  // Find XR data entities using A-Frame/Babia selectors
  let dataEntities = [];
  
  // Common XR data entity selectors
  dataEntities = [...dataEntities, ...document.querySelectorAll('#xr-data')];
  dataEntities = [...dataEntities, ...document.querySelectorAll('#data')];
  dataEntities = [...dataEntities, ...document.querySelectorAll('[babia-queryjson]')];
  dataEntities = [...dataEntities, ...document.querySelectorAll('[data-source]')];
  
  // Find XR chart entities using common class selector
  let chartEntities = [];
  
  chartEntities = [...chartEntities, ...document.querySelectorAll('#xr-chart')];
  chartEntities = [...chartEntities, ...document.querySelectorAll('#chart')];
  // Use the common class for all babia charts
  chartEntities = [...chartEntities, ...document.querySelectorAll('.babiaxraycasterclass')];
  
  if (dataEntities.length > 0) {
    const timestamp = Date.now();
    console.log('🥽 XR Analysis: Refreshing ' + dataEntities.length + ' XR data entities');
    
    // Update each data entity with cache busting
    dataEntities.forEach(dataEntity => {
      // Handle babia-queryjson attributes
      const queryjson = dataEntity.getAttribute('babia-queryjson');
      if (queryjson) {
        // Add cache busting parameter
        const urlStr = typeof queryjson === 'string' ? queryjson : queryjson.url || '';
        let url = '';
        
        if (typeof urlStr === 'string') {
          url = urlStr.split('?')[0] + '?t=' + timestamp;
        }
        
        // Handle both string and object attributes
        if (typeof queryjson === 'string') {
          dataEntity.setAttribute('babia-queryjson', url);
        } else {
          const newAttr = { ...queryjson };
          newAttr.url = url;
          dataEntity.setAttribute('babia-queryjson', newAttr);
        }
        
        console.log('🥽 XR Analysis: Updated babia-queryjson with cache buster:', url);
      }
      
      // Handle custom data-source attributes
      const dataSource = dataEntity.getAttribute('data-source');
      if (dataSource) {
        const newDataSource = dataSource.split('?')[0] + '?t=' + timestamp;
        dataEntity.setAttribute('data-source', newDataSource);
        console.log('🥽 XR Analysis: Updated data-source with cache buster:', newDataSource);
      }
      
      // Trigger data refresh event after a short delay
      setTimeout(() => {
        dataEntity.emit('data-loaded', {});
        dataEntity.emit('xr-data-refreshed', { timestamp: timestamp });
        console.log('🥽 XR Analysis: Data entity refreshed');
      }, 100);
    });

    // Rebuild XR charts after data is loaded
    setTimeout(() => {
      chartEntities.forEach(chartEntity => {
        // Find which component type is used
        const chartTypes = ["babia-bars", "babia-cylinders", "babia-pie", "babia-donut", "babia-barsmap", "babia-bubbles"];
        
        for (const type of chartTypes) {
          if (chartEntity.hasAttribute(type)) {
            const attributes = chartEntity.getAttribute(type);
            console.log('🥽 XR Analysis: Rebuilding ' + type + ' chart');
            
            // Remove and re-add component to force refresh
            chartEntity.removeAttribute(type);
            setTimeout(() => {
              chartEntity.setAttribute(type, attributes);
              chartEntity.emit('chart-rebuilt', { type: type });
              console.log('🥽 ✅ XR Chart rebuilt successfully');
            }, 50);
            break;
          }
        }
      });
    }, 200);
    
    // Show success notification
    setTimeout(() => {
      showXRReloadNotification();
    }, 500);
    
  } else {
    console.warn('🥽 ⚠️ No XR data entities found for refresh');
    
    // For non-A-Frame XR analysis, try to reload data.json directly
    reloadXRDataFile();
  }
}

/**
 * Reload XR data file (data.json) directly for non-A-Frame XR analysis
 */
function reloadXRDataFile() {
  console.log('🥽 XR Analysis: Attempting to reload data.json directly...');
  
  // Add cache busting to ensure fresh data
  fetch('./data.json?t=' + Date.now())
    .then(response => {
      if (!response.ok) {
        throw new Error(`HTTP ${response.status}: ${response.statusText}`);
      }
      return response.json();
    })
    .then(data => {
      console.log('🥽 XR Analysis: Successfully reloaded data.json via SSE');
      
      // Trigger custom event for XR analysis components to handle
      const event = new CustomEvent('xr-analysis-data-updated', {
        detail: { data: data, timestamp: Date.now() }
      });
      document.dispatchEvent(event);
      
      showXRReloadNotification();
    })
    .catch(error => {
      console.error('🥽 XR Analysis: Failed to reload data.json:', error);
      showXRError('Failed to reload XR analysis data: ' + error.message);
    });
}

/**
 * Show XR SSE connection status
 */
function showXRStatus(status) {
  // Create or update XR status indicator
  let statusElement = document.getElementById('xr-sse-status');
  if (!statusElement) {
    statusElement = document.createElement('div');
    statusElement.id = 'xr-sse-status';
    statusElement.style.cssText = `
      position: fixed;
      top: 10px;
      left: 10px;
      padding: 5px 10px;
      border-radius: 4px;
      font-size: 12px;
      z-index: 1000;
      transition: all 0.3s ease;
      font-family: inherit;
      border: 2px solid transparent;
    `;
    document.body.appendChild(statusElement);
  }
  
  switch (status) {
    case 'connected':
      statusElement.textContent = '🥽🟢 XR Live Updates';
      statusElement.style.backgroundColor = '#10b981';
      statusElement.style.color = 'white';
      statusElement.style.borderColor = '#059669';
      break;
    case 'error':
      statusElement.textContent = '🥽🔴 XR Disconnected';
      statusElement.style.backgroundColor = '#ef4444';
      statusElement.style.color = 'white';
      statusElement.style.borderColor = '#dc2626';
      break;
  }
}

/**
 * Show XR update notification
 */
function showXRUpdateNotification() {
  showXRNotification('🥽 XR Analysis updated! Refreshing data...', '#3b82f6', 3000);
}

/**
 * Show XR reload completion notification
 */
function showXRReloadNotification() {
  showXRNotification('🥽 XR Data refreshed successfully!', '#10b981', 2000);
}

/**
 * Show XR error notification
 */
function showXRError(message) {
  showXRNotification('🥽 ❌ ' + message, '#ef4444', 5000);
}

/**
 * Show a temporary XR notification
 */
function showXRNotification(message, backgroundColor = '#3b82f6', duration = 3000) {
  const notification = document.createElement('div');
  notification.style.cssText = `
    position: fixed;
    top: 50px;
    left: 10px;
    background: ${backgroundColor};
    color: white;
    padding: 10px 15px;
    border-radius: 4px;
    font-size: 14px;
    z-index: 1001;
    font-family: inherit;
    box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    animation: xrSlideIn 0.3s ease;
    border: 2px solid rgba(255,255,255,0.2);
  `;
  notification.textContent = message;
  
  document.body.appendChild(notification);
  
  // Remove notification after specified duration
  setTimeout(() => {
    notification.remove();
  }, duration);
}

// Add CSS for XR animations if not already present
if (!document.getElementById('xr-sse-animations')) {
  const style = document.createElement('style');
  style.id = 'xr-sse-animations';
  style.textContent = `
    @keyframes xrSlideIn {
      from {
        transform: translateX(-100%);
        opacity: 0;
      }
      to {
        transform: translateX(0);
        opacity: 1;
      }
    }
  `;
  document.head.appendChild(style);
}

// Initialize XR mode detection and status
document.addEventListener('DOMContentLoaded', function() {
  checkXRMode();
  showXRStatus('connected');
});

// Export for debugging and external access
window.XRAnalysisSSE = {
  eventSource: eventSource,
  isXRMode: () => isXRMode,
  reload: reloadXRAnalysisData,
  reloadDataFile: reloadXRDataFile,
  checkMode: checkXRMode
};

console.log('🥽 XR File Analysis SSE client initialized');
